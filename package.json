{
  "name": "discordex",
  "version": "0.1.0",
  "description": "A self-hosted Discord client for the shared Codex daemon",
  "private": true,
  "type": "module",
  "bin": { "discordex": "src/cli.ts" },
  "engines": { "bun": ">=1.3.0" },
  "packageManager": "bun@1.4.4",
  "scripts": {
    "build": "bun build src/cli.ts --target=bun --packages=external --outdir=dist",
    "build:release": "bun scripts/build-release.ts",
    "check": "tsc --noEmit",
    "test": "bun test",
    "dev": "bun --watch src/cli.ts start",
    "start": "bun src/cli.ts start",
    "doctor": "bun src/cli.ts doctor"
  },
  "dependencies": {
    "discord.js": "14.28.1",
    "mdast-util-from-markdown": "^2.1.0",
    "sharp": "0.34.5",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/ws": "^8.18.1",
    "typescript": "~5.9.3"
  }
}
